APP_NAME="BMP Digital Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Behind a load balancer or CDN, name it here - its address, a comma-separated
# list, or '*' when nothing can reach the app except through it. Empty means
# trust nothing, which is correct for a directly reachable server: a forwarded
# header is trivially forged, and two things depend on the caller's real
# address - external-link rate limiting, and the IP recorded against a used
# access grant.
TRUSTED_PROXIES=

# Leave unset locally. In production the app defaults this to true anyway
# (APP_ENV=production), so set it only to override.
# SESSION_SECURE_COOKIE=true

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development database (ADR-005): SQLite. No MySQL server is available in this
# environment. With DB_DATABASE unset, Laravel resolves the file to
# database_path('database.sqlite'), which is absolute and cwd-independent.
DB_CONNECTION=sqlite
# DB_DATABASE=

# Intended production database (ADR-006): MySQL. Uncomment and set these, and
# change DB_CONNECTION to mysql, once a MySQL server is available.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bmp
# DB_USERNAME=
# DB_PASSWORD=
#
# The connection is pinned to UTC in config/database.php so that MySQL does not
# convert the 140 TIMESTAMP columns by the server's zone. Override only if you
# know why you are doing it, and only before the first production write.
# DB_TIMEZONE=+00:00

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail into storage/logs/laravel.log instead of sending it, which
# is right locally and wrong in production - password-reset tokens would be
# written to a file. Set MAIL_MAILER=smtp and fill in the rest before go-live.
# Port and encryption vary by provider: 465/ssl and 587/tls are both common.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# BMP notification delivery. 'mail' sends the nine SOW triggers by email through
# the MAIL_* settings above. 'none' binds the dispatcher that refuses, so every
# dispatch is recorded as failed with its reason - the honest way to run with
# notifications switched off. Email is the only channel implemented.
NOTIFICATIONS_CHANNEL=mail
# NOTIFICATIONS_MAX_ATTEMPTS=3
# NOTIFICATIONS_QUEUE=default

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider. Leave AI_PROVIDER unset (or 'null') and the application refuses
# to generate rather than fabricating a response. Set it to 'anthropic' and
# supply a key to enable generation. NEVER commit a real key - this file
# carries names only.
AI_PROVIDER=null
ANTHROPIC_API_KEY=

# Where generated report files are written. Keep it on a PRIVATE disk. A report
# aggregates a whole business's position, so 'public' would put it behind a URL
# that needs no authorization at all.
REPORTS_DISK=local

# The first Super Admin, created by the seeder on a fresh install. Set both
# before seeding production: with the email left at its example default the
# seeder REFUSES to run there rather than create a guessable administrator.
# Leave the password empty and one is generated and printed once - which is the
# recommended way, because it cannot then exist in a file.
BMP_SUPER_ADMIN_NAME="Super Admin"
BMP_SUPER_ADMIN_EMAIL=
BMP_SUPER_ADMIN_PASSWORD=

# Queue worker retry window. Must exceed the longest job's runtime, or the
# queue will hand a still-running job to a second worker.
# DB_QUEUE_RETRY_AFTER=90
